# ============================================================
# Пример файла .env — копия с безопасными значениями.
# В git идёт ЭТОТ файл, а реальный .env — в .gitignore.
# ============================================================
# Как использовать:
#   1. Скопировать файл:   copy .env.example .env
#   2. Изменить пароли в .env (в примере — безопасные для локалки)
#   3. Запустить:          docker-compose up -d
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin_password_change_me
POSTGRES_DB=KnowledgeDb
POSTGRES_PORT=5433

# --- RabbitMQ ---
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin_password_change_me
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Redis ---
REDIS_PORT=6379
